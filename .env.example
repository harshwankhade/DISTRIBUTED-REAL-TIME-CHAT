# Shared runtime settings
APP_ENV=development
LOG_LEVEL=INFO
GRPC_WORKERS=10
RPC_TIMEOUT_SECONDS=5
STREAM_KEEPALIVE_SECONDS=1
SHUTDOWN_GRACE_SECONDS=5
SESSION_TTL_SECONDS=3600

# Placeholder chat service (logical Node 2 during Milestone 1)
CHAT_NODE_ID=chat-node-1
CHAT_HOST=127.0.0.1
CHAT_PORT=50051
CHAT_DATABASE_PATH=data/chat-node-1.db
FILE_STORAGE_PATH=uploads/chat-node-1
MAX_FILE_SIZE_BYTES=10485760
FILE_CHUNK_SIZE_BYTES=65536
ALLOWED_FILE_TYPES=text/plain,application/pdf,image/png,image/jpeg,application/octet-stream
MAX_MESSAGE_LENGTH=4000
PRESENCE_TIMEOUT_SECONDS=15

# Placeholder LLM service (logical Node 1)
LLM_NODE_ID=llm-node-1
LLM_HOST=127.0.0.1
LLM_PORT=50061
LLM_ADAPTER=mock
LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
LLM_CONTEXT_WINDOW=4096
LLM_MAX_OUTPUT_TOKENS=256
LLM_THREADS=8
LLM_GPU_LAYERS=0
LLM_TEMPERATURE=0.2
LLM_MAX_CONTEXT_MESSAGES=40
LLM_MAX_CONTEXT_CHARS=12000
LLM_REQUEST_TIMEOUT_SECONDS=30

# Placeholder client identity (logical Node 5)
CLIENT_ID=client-1

# Optional local-only credentials for the --smoke client.
# Register this account in the GUI first. Never commit the .env file.
SMOKE_USERNAME=alice
SMOKE_PASSWORD=
